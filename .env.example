# Base de données (SQLite fichier local)
DATABASE_URL="file:./dev.db"

# Secret utilisé pour signer les sessions admin (JWT). Générer une valeur aléatoire longue,
# par ex. avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-value"

# Mot de passe administrateur initial (amorce du tout premier déploiement uniquement).
# Utilisé par le script de seed pour créer le compte admin. Change-le après le premier login :
# une modale de changement de mot de passe obligatoire s'affichera automatiquement.
ADMIN_INITIAL_PASSWORD="tetramack2026"

# Resend (envoi de l'e-mail du formulaire de contact) — https://resend.com/api-keys
RESEND_API_KEY=""
# Adresse d'expédition affichée sur les e-mails envoyés par le formulaire de contact.
# Doit appartenir à un domaine vérifié dans Resend (sinon utiliser onboarding@resend.dev en test).
CONTACT_FROM_EMAIL="Tetra Mack & Co <onboarding@resend.dev>"
